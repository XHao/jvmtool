{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure native (Debug)",
      "type": "shell",
      "command": "cmake -S native -B native/build -DCMAKE_BUILD_TYPE=Debug",
      "problemMatcher": []
    },
    {
      "label": "Build native (Debug)",
      "type": "shell",
      "dependsOn": "Configure native (Debug)",
      "command": "cmake --build native/build --config Debug -j4",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Run jattach with prompts",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "./cmd",
        "jattach",
        "-pid",
        "${input:javaPid}",
        "-agentpath",
        "${input:agentPath}",
        "-agentparams",
        "${input:agentParams}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    }
  ],
  "inputs": [
    {
      "id": "javaPid",
      "type": "promptString",
      "description": "Target Java PID",
      "default": ""
    },
    {
      "id": "agentPath",
      "type": "promptString",
      "description": "Path to native agent (dylib)",
      "default": "${workspaceFolder}/native/build/jvmtool-agent.dylib"
    },
    {
      "id": "agentParams",
      "type": "promptString",
      "description": "Agent parameters (use analysis=memory for SA module)",
      "default": "analysis=memory"
    }
  ]
}
