{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/native/include",
                "${workspaceFolder}/native/src",
                "${workspaceFolder}/native/src/vm",
                "${env:JAVA_HOME}/include",
                "/usr/local/include",
                "/opt/homebrew/include"
            ],
            "defines": [
                "JVMTOOL_CHECKSUM"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64",
            "compileCommands": "${workspaceFolder}/native/build/compile_commands.json",
            "compilerArgs": [
                "-std=gnu++17",
                "-Wall",
                "-Wextra",
                "-arch",
                "arm64"
            ]
        }
    ],
    "version": 4
}