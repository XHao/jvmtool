{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Native Tests",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/native/build/jvmtool-agent-test",
            "cwd": "${workspaceFolder}/native/build",
            "stopOnEntry": false,
            "terminal": "integrated"
        },
        {
            "name": "Attach to Java Process (LLDB)",
            "type": "lldb",
            "request": "attach",
            "pid": "${input:javaPid}",
            "stopOnEntry": false,
            "sourceMap": {
                "/Users/shako/workspace/jattach/native": "${workspaceFolder}/native"
            }
        },
        {
            "name": "Debug Go SA Command",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd",
            "args": [
                "sa",
                "--pid",
                "${input:javaPid}",
                "--analysis",
                "memory"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "javaPid",
            "description": "Java process PID",
            "default": "",
            "type": "promptString"
        }
    ]
}